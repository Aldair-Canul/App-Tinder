<?xml version="1.0" encoding="UTF-8"?>

<!-- ==================== IMPORTACIONES ==================== -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>


<!-- ==================== CONTENEDOR PRINCIPAL ==================== -->

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="470.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controladores.ControladorLogin">

   <children>


      <!-- ==================== FONDO DE LA VENTANA ==================== -->

      <ImageView fitHeight="470.0"
                 fitWidth="600.0"
                 pickOnBounds="true"
                 preserveRatio="false">

         <image>

            <!-- Imagen utilizada como fondo -->
            <Image url="@../Imagenes/fondo.jpg" />

         </image>

      </ImageView>


      <!-- ==================== PANEL DE INICIO DE SESIÓN ==================== -->

      <AnchorPane layoutX="114.0"
                  layoutY="56.0"
                  prefHeight="357.0"
                  prefWidth="371.0"
                  style="-fx-background-color: rgba(255, 255, 255, 0.8);
                         -fx-background-radius: 20;">

         <children>


            <!-- ==================== TÍTULO ==================== -->

            <Label layoutX="108.0"
                   layoutY="26.0"
                   text="INICIAR SESION"
                   textAlignment="CENTER">

               <font>

                  <Font size="22.0" />

               </font>

            </Label>


            <!-- ==================== CREDENCIALES: CORREO Y CONTRASEÑA ==================== -->

            <Label layoutX="26.0"
                   layoutY="82.0"
                   prefHeight="18.0"
                   prefWidth="111.0"
                   text="Correo:" />

            <TextField fx:id="txtCorreo"
                       layoutX="26.0"
                       layoutY="107.0"
                       prefHeight="26.0"
                       prefWidth="329.0" />

            <Label layoutX="26.0"
                   layoutY="146.0"
                   text="Contraseña:" />

            <PasswordField fx:id="pwdContraseña"
                           layoutX="26.0"
                           layoutY="164.0"
                           prefHeight="26.0"
                           prefWidth="330.0" />


            <!-- ==================== ACCIÓN: INGRESAR ==================== -->

            <Button fx:id="btnIngresar"
                    layoutX="161.0"
                    layoutY="217.0"
                    mnemonicParsing="false"
                    onAction="#iniciarSesion"
                    text="Ingresar" />


            <!-- ==================== SEPARADOR ==================== -->

            <Line endX="149.79998779296875"
                  endY="-3.0517578125E-5"
                  layoutX="182.0"
                  layoutY="268.0"
                  startX="-144.0"
                  startY="-3.0517578125E-5" />


            <!-- ==================== NAVEGACIÓN A REGISTRO ==================== -->

            <Label layoutX="89.0"
                   layoutY="292.0"
                   prefHeight="26.0"
                   prefWidth="103.0"
                   text="¿No tienes Cuenta?" />

            <!-- Enlace que envía a la pantalla de registro -->
            <Hyperlink fx:id="lnkRegistrarse"
                       layoutX="220.0"
                       layoutY="293.0"
                       onAction="#irARegistro"
                       text="Registrarse" />


         </children>

      </AnchorPane>


   </children>

</AnchorPane>