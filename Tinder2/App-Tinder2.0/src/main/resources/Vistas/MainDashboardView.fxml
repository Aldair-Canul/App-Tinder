<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="dashboardPrincipal"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="600.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controladores.ControladorDashboard">


    <!-- ==================== PANEL DE FILTROS ==================== -->
    <left>
        <VBox fx:id="panelFiltros"
              alignment="TOP_CENTER"
              prefHeight="200.0"
              prefWidth="230.0"
              spacing="15.0"
              style="-fx-background-color: #FFF7F9;
                   -fx-border-color: #F3D7DF;
                   -fx-border-width: 0 1 0 0;"
              BorderPane.alignment="TOP_CENTER">

            <padding>
                <Insets bottom="25.0" left="20.0" right="20.0" top="25.0" />
            </padding>

            <children>

                <Label fx:id="lblTituloFiltros"
                       style="-fx-text-fill: #C93664;
                          -fx-font-size: 19px;
                          -fx-font-weight: bold;"
                       text="Filtros de Búsqueda">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <Label style="-fx-text-fill: #374151;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"
                       text="Edad:" />

                <TextField fx:id="txtEdad"
                           prefHeight="35.0"
                           prefWidth="190.0"
                           promptText="Ej. 22"
                           style="-fx-background-color: white;
                              -fx-border-color: #D6D6D6;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-font-size: 13px;" />

                <Label style="-fx-text-fill: #374151;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"
                       text="Intereses / Gustos:" />

                <ComboBox fx:id="comboIntereses"
                          prefHeight="35.0"
                          prefWidth="190.0"
                          promptText="Selecciona un interés"
                          style="-fx-background-color: white;
                             -fx-border-color: #D6D6D6;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;" />

                <Button fx:id="btnFiltrar"
                        mnemonicParsing="false"
                        onAction="#filtrarPerfiles"
                        prefHeight="38.0"
                        prefWidth="190.0"
                        style="-fx-background-color: #FF5C8A;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="Aplicar filtros" />

            </children>
        </VBox>
    </left>

    <!-- ==================== ÁREA DE PERFILES ==================== -->
    <center>
        <ScrollPane fx:id="scrollPerfiles"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    prefHeight="200.0"
                    prefWidth="200.0"
                    style="-fx-background: #FAFAFA;
                         -fx-background-color: #FAFAFA;"
                    BorderPane.alignment="TOP_CENTER">

            <content>

                <VBox fx:id="contenidoDashboard"
                      alignment="TOP_CENTER"
                      prefHeight="200.0"
                      prefWidth="100.0"
                      spacing="20.0"
                      style="-fx-background-color: #FAFAFA;">

                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>

                    <children>

                        <Label fx:id="lblTituloDashboard"
                               style="-fx-text-fill: #C93664;
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;"
                               text="Descubre personas cerca de ti 💕" />

                        <Label fx:id="lblSubtituloDashboard"
                               style="-fx-text-fill: #6B7280;
                                -fx-font-size: 14px;"
                               text="Encuentra personas que compartan tus intereses 💘" />

                        <FlowPane fx:id="contenedorPerfiles"
                                  alignment="TOP_CENTER"
                                  hgap="20.0"
                                  prefHeight="200.0"
                                  prefWidth="200.0"
                                  prefWrapLength="600.0"
                                  vgap="20.0">

                            <children>

                                <!-- TARJETA DE PERFIL DE EJEMPLO -->
                                <VBox fx:id="tarjetaPerfilEjemplo"
                                      alignment="TOP_CENTER"
                                      prefHeight="410.0"
                                      prefWidth="260.0"
                                      spacing="10.0"
                                      style="-fx-background-color: white;
                                     -fx-background-radius: 16;
                                     -fx-border-radius: 16;
                                     -fx-border-color: #F1D5DD;
                                     -fx-border-width: 1;">

                                    <padding>
                                        <Insets bottom="15.0"
                                                left="15.0"
                                                right="15.0"
                                                top="15.0" />
                                    </padding>

                                    <children>

                                        <ImageView fx:id="imgPerfilEjemplo"
                                                   fitHeight="150.0"
                                                   fitWidth="150.0"
                                                   pickOnBounds="true"
                                                   preserveRatio="true"
                                                   smooth="true">
                                            <image>
                                                <Image url="@../Imagenes/sexybyte.jpeg" />
                                            </image>
                                        </ImageView>

                                        <Label fx:id="lblNombrePerfilEjemplo"
                                               style="-fx-text-fill: #C93664;
                                            -fx-font-size: 20px;
                                            -fx-font-weight: bold;"
                                               text="Sexybyte, 22" />

                                        <Label fx:id="lblInteresesPerfilEjemplo"
                                               style="-fx-text-fill: #6B7280;
                                            -fx-font-size: 13px;"
                                               text="🎵 Música • 🎬 Series • ☕ Café" />

                                        <Label fx:id="lblDistanciaPerfilEjemplo"
                                               style="-fx-text-fill: #6B7280;
                                            -fx-font-size: 13px;"
                                               text="📍 A 3 km de ti 😈" />

                                        <Button fx:id="btnVerPerfilEjemplo"
                                                mnemonicParsing="false"
                                                prefHeight="42.0"
                                                prefWidth="220.0"
                                                style="-fx-background-color: #FF5C8A;
                                             -fx-text-fill: white;
                                             -fx-font-weight: bold;
                                             -fx-background-radius: 8;
                                             -fx-cursor: hand;
                                             -fx-font-size: 14px;"
                                                text="Ver perfil 👀" />

                                    </children>
                                </VBox>

                            </children>
                        </FlowPane>

                    </children>
                </VBox>

            </content>
        </ScrollPane>
    </center>

    <!-- ==================== BARRA SUPERIOR ==================== -->
    <top>

        <HBox fx:id="barraSuperior"
              alignment="CENTER_LEFT"
              prefHeight="65.0"
              prefWidth="200.0"
              spacing="12.0"
              style="-fx-background-color: #FF5C8A;
                   -fx-padding: 12 22 12 22;"
              BorderPane.alignment="CENTER_LEFT">

            <children>

                <Label fx:id="lblNombreAplicacion"
                       style="-fx-text-fill: white;
                          -fx-font-size: 24px;
                          -fx-font-weight: bold;"
                       text="ERROR 404: AMOR" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnBandeja"
                        mnemonicParsing="false"
                        prefHeight="36.0"
                        prefWidth="100.0"
                        style="-fx-background-color: white;
                           -fx-text-fill: #C93664;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="Bandeja" />

                <Button fx:id="btnMiPerfil"
                        mnemonicParsing="false"
                        prefHeight="36.0"
                        prefWidth="100.0"
                        style="-fx-background-color: white;
                           -fx-text-fill: #C93664;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="Mi perfil" />

            </children>
        </HBox>

    </top>

</BorderPane>