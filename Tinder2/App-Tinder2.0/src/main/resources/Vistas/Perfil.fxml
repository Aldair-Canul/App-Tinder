<?xml version="1.0" encoding="UTF-8"?>

<!-- ==================== IMPORTACIONES ==================== -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>


<!-- ==================== CONTENEDOR PRINCIPAL ==================== -->

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="496.0"
            prefWidth="600.0"
            style="-fx-background-color: pink;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controladores.ControladorPerfil">

   <children>


      <!-- ==================== FONDO DE LA VENTANA ==================== -->


      <ImageView fitHeight="496.0"
                 fitWidth="600.0"
                 pickOnBounds="true"
                 preserveRatio="false">

         <image>

            <!-- Imagen utilizada como fondo -->
            <Image url="@../Imagenes/fondo2.jpg" />

         </image>

      </ImageView>


      <!-- ==================== PANEL DEL PERFIL ==================== -->

      <AnchorPane layoutX="108.0"
                  layoutY="17.0"
                  prefHeight="461.0"
                  prefWidth="383.0"
                  style="-fx-background-radius: 20;
                         -fx-background-color: rgba(255, 255, 255, 0.8);">

         <children>


            <!-- ==================== TÍTULO ==================== -->

            <Label layoutX="154.0"
                   layoutY="14.0"
                   text="PERFIL">

               <font>

                  <Font size="22.0" />

               </font>

            </Label>


            <!-- ==================== FOTO DE PERFIL ==================== -->

            <StackPane layoutX="91.5"
                       layoutY="52.0"
                       prefWidth="200.0"
                       prefHeight="150.0">
               <children>
                  <ImageView fx:id="imgFoto"
                             fitHeight="150.0"
                             fitWidth="200.0"
                             pickOnBounds="true"
                             preserveRatio="true" />
               </children>
            </StackPane>

            <Button fx:id="btnAgregarFoto"
                    layoutX="144.0"
                    layoutY="210.0"
                    mnemonicParsing="false"
                    onAction="#agregarFoto"
                    text="Agregar foto" />


            <!-- ==================== APODO ==================== -->

            <Label layoutX="14.0"
                   layoutY="257.0"
                   prefHeight="18.0"
                   prefWidth="98.0"
                   text="Apodo (opcional):" />

            <TextField fx:id="txtApodo"
                       layoutX="125.0"
                       layoutY="253.0"
                       prefHeight="26.0"
                       prefWidth="232.0" />


            <!-- ==================== GÉNERO ==================== -->

            <ComboBox fx:id="cbGenero"
                      layoutX="125.0"
                      layoutY="291.0"
                      prefWidth="150.0"
                      promptText="Hombre" />

            <Label layoutX="42.0"
                   layoutY="295.0"
                   text="Genero:" />


            <!-- ==================== DESCRIPCIÓN ==================== -->

            <Label layoutX="31.0"
                   layoutY="359.0"
                   text="Descripcion:" />

            <TextArea fx:id="txtDescripcion"
                      layoutX="125.0"
                      layoutY="331.0"
                      prefHeight="74.0"
                      prefWidth="232.0" />


            <!-- ==================== BOTÓN SIGUIENTE ==================== -->

            <Button fx:id="btnSiguiente"
                    layoutX="275.0"
                    layoutY="422.0"
                    mnemonicParsing="false"
                    onAction="#irSiguiente"
                    text="Siguiente -->" />


         </children>

      </AnchorPane>


   </children>

</AnchorPane>